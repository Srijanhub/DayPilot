# ==============================================================================
# DAYPILOT CONFIGURATION & REAL-WORLD API CREDENTIALS
# Copy this file to .env and populate your personal keys:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB INTEGRATION (Live Pull Requests & Notifications)
# Option A: Run `gh auth login` in your terminal.
# Option B: Create a Personal Access Token at https://github.com/settings/tokens
# Required Scopes: `notifications`, `repo`, `read:org`
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 2. GOOGLE SUITE (Gmail Priority Digest & Google Calendar)
# Account: onlinesrijanhalder@gmail.com
# 
# CALENDAR: The easiest zero-config way is your Google Calendar Secret iCal URL:
# 1. Open Google Calendar -> Settings -> Click your calendar under "Settings for my calendars"
# 2. Scroll to "Integrate calendar" -> Copy "Secret address in iCal format"
GOOGLE_CALENDAR_ICAL_URL=

# GMAIL:
# Option A: Google Cloud OAuth (Client ID & Secret from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B: Google App Password (Fastest, zero GCP project needed)
# 1. Go to https://myaccount.google.com/security -> 2-Step Verification -> App passwords
# 2. Create one named "DayPilot" and paste the 16-character code below:
GMAIL_ADDRESS=onlinesrijanhalder@gmail.com
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 3. BOSSCODER ACADEMY INTEGRATION (Live Assignments & Mentorship Lectures)
# To get your session auth token:
# 1. Log in to https://school.bosscoderacademy.com in Opera GX
# 2. Open Developer Tools (Cmd+Option+I) -> Application tab -> Cookies or LocalStorage
# 3. Look for "token" or "jwt" and copy its value below:
# ------------------------------------------------------------------------------
BOSSCODER_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. LLM INTELLIGENCE (Morning Ignition Directive & Voice Memo Transcription)
# Used for synthesizing your personalized daily plan and audio memos.
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Or OpenAI key (optional fallback)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. SERVER SETTINGS & AUTH
# ------------------------------------------------------------------------------
DAYPILOT_PORT=4000
DAYPILOT_ENV=production
# Leave blank to auto-generate a secure 256-bit token in ~/daypilot/token on first run:
DAYPILOT_API_TOKEN=
DAYPILOT_BROWSER="Opera GX"
USER_NAME=Developer
GITHUB_USERNAME=Developer
